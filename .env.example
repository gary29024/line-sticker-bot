# Copy this file to ".env" and fill in your values (only needed when running on your own computer).
# On Railway / Fly.io, type these into the website's Variables / Secrets page instead.

# Required: the token @BotFather gave you
BOT_TOKEN=123456789:replace-me

# Optional: only these Telegram user IDs may use the bot (comma-separated). Empty = anyone.
# Send /myid to the bot to find your ID.
ALLOWED_USER_IDS=

# Optional: people who may edit ANY set the bot made (comma-separated user IDs)
ADMIN_IDS=

# Optional: where the bot keeps its small database
DATA_DIR=data

# Optional: the emoji used when you tap "Use ⭐ for all"
DEFAULT_EMOJI=⭐

# Optional: how many packs may be converted at the same time (raise on a bigger server)
MAX_JOBS=2
CONVERT_WORKERS=2
